# Frontend environment variables (all VITE_* vars are PUBLIC / embedded in the build).
# Copy to .env.local for personal overrides, or set in Render's dashboard.

# Base URL of the backend API (must end with /api/v1).
#   dev  : /api/v1                     (proxied by Vite to localhost:8080)
#   prod : https://<backend>.onrender.com/api/v1
VITE_API_BASE_URL=/api/v1
